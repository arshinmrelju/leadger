# TRUSTX LEDGER - environment variables example
# Copy to `.env` and fill in IF you rely on env config in CI tooling.
# The Firebase web client config is entered directly in `js/firebase.js`
# (client config is public by design and is not a secret).

# Project used by the Firebase CLI (firebase deploy / firebase emulators)
FIREBASE_PROJECT_ID=trustxplpy

# Optional environment label for `firebase use --add <alias>`.
FIREBASE_PROJECT_ALIAS=default

# Deploy BOTH rule sets, not just Firestore:
#   firestore.rules        the money - dayHeads/{dateKey} and that day's sales
#   database.rules.json    shop identity, codes, devices, catalog, expenses
#   firebase deploy --only firestore,database
#
# The Realtime Database URL also has to match the console
# (Project settings -> Your apps -> Web app -> Realtime Database);
# it lives in `databaseURL` in js/firebase.js and is NOT a secret.
