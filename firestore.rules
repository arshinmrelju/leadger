rules_version = '2';

// =============================================================
// TRUSTX LEDGER — Cloud Firestore security rules
// -------------------------------------------------------------
// EVERYTHING THAT GATES ACCESS LIVES HERE, NEXT TO THE MONEY.
//
//   allowedUsers/{email}   { email, role } the Google-account
//                             allowlist. Never readable and never
//                             writable by a client — only the bootstrap
//                             tool (tools/bootstrap-access.mjs, Admin
//                             SDK) can write it. A missing entry fails
//                             CLOSED: no enrollment can match it.
//   enrollments/{uid}        one-time proof-of-authorisation, keyed by
//                             the caller's own uid. The create rule is
//                             where the allowlist is actually checked,
//                             server-side: the caller sends only their
//                             email, never a password.
//   accessGrants/{uid}       the trusted-browser registry and the ONLY
//                             thing the money rules below consult. A
//                             Google Firebase user with no grant reads
//                             and writes nothing.
//
// The trust chain is therefore: Google account (verified by Firebase)
// -> allowlist entry (server compares the email) -> accessGrant
// (server-authoritative) -> money access. Revoking a grant locks the
// browser out immediately, because every rule below re-reads the grant
// on every request.
//
// Realtime Database holds only non-authoritative data:
//   settings/general   shop identity
//   expenses/{dateKey} spends (read-only this build)

// DATA MODEL COVERED HERE
//   allowedUsers/{email}                       the Google-account allowlist
//   enrollments/{uid}                           one-time proof-of-authorisation
//   accessGrants/{uid}                          trusted browsers + admin role
//   dayHeads/{dateKey}                          the independent head for
//                                               one Asia/Kolkata business day
//   dayHeads/{dateKey}/transactions/{txnId}     the sales recorded that day
//   services/{serviceId}                        the quick-service catalog
//
// A HEAD PER DAY, NOT A dateKey FIELD
//   The old model was one flat transactions collection with a dateKey
//   field, which meant every day view was a filter plus a composite
//   index and a day that grew large grew unreadable. Now the day IS the
//   partition: a day's sales are a subcollection of that day's head, so
//   reading a day needs no index at all, and one busy day can never
//   slow down another.
//
// WHAT THE HEAD CARRIES
//   dateKey, state (open | closed), openedAt/By, closedAt/By, and a
//   `counters` block holding the day's running totals. That makes the
//   head a one-document answer to "how did today go?", and it replaces
//   the old close-day register, which used the existence of a
//   days/{dateKey} document to mean "closed".
//
// MONEY
//   All money is integer paise. `rate` is paise per unit, `total` is
//   always quantity x rate, and the rules re-derive it on every write,
//   so money is never client-asserted. `amounts` is the per-method split
//   of that total and is proved to agree with `paymentMethod`.
//
// COUNTER INTEGRITY
//   A sale and the day's totals are written in ONE atomic batch, and the
//   SALE's own rules check the head moved by exactly this sale's
//   contribution (create), by exactly the difference between the old and
//   new split (edit), or by exactly minus this sale (delete). Because
//   rules cannot re-sum a subcollection, this is as strong as the rows
//   themselves: there is no path where a sale lands and the head does
//   not follow.
//   The head's OWN update rule cannot see the sale, so it only permits
//   a no-op merge, a single-sale-sized delta inside the money cap, and
//   the one-way open -> closed transition. A caller who writes the head
//   alone can therefore skew the DISPLAY counters by at most one sale
//   per write — and the daily ledger always recomputes its totals from
//   the rows, so the pages that matter never trust the counters.
//
// SERVICE CATALOG
//   The service catalog lives in Cloud Firestore under /services/{serviceId},
//   alongside transactions. Because they share the same database, transaction
//   rules directly verify via get() and exists() that the serviceId exists,
//   is active, and matches serviceName.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------------- Trust ----------------
    // The allowlist. Unreadable by every client on purpose: a list
    // that a browser can read is a list an attacker can enumerate,
    // so the comparison below is the only place an email is ever
    // checked, and it happens here.
    //
    // The document ID IS the email address. Firestore document IDs may
    // contain '@' and '.', and the rules language can only reach a
    // document by an exact path — it has no hashing function and no way
    // to look a document up by a field — so the id that
    // tools/bootstrap-access.mjs writes and the id built here have to be
    // the same string. That tool percent-encodes each REST path segment,
    // so an address travels fine. (An earlier version hashed the email
    // on the way in, which made this lookup unsatisfiable and left the
    // app refusing every account including the owner's.)
    function allowedUserPath(email) {
      return /databases/$(database)/documents/allowedUsers/$(email);
    }

    // The only email these rules will reason about is the one Firebase
    // verified on the ID token. Signing in with Google is open to
    // anybody, so a string a client merely *claims* proves nothing: the
    // allowlist is looked up by `request.auth.token.email`, and the
    // claimed `email` field must equal it or the proof is refused. That
    // equality is load-bearing — without it, any signed-in account could
    // name somebody else's address and inherit their role.
    //
    // The token's address is used verbatim, so the allowlist must hold
    // the same bytes. tools/bootstrap-access.mjs lower-cases on the way
    // in, and so does the client, which is what keeps the two equal.
    function isAllowedEmail(email) {
      return request.auth.token.email is string
        && request.auth.token.email == email
        && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$')
        && exists(allowedUserPath(request.auth.token.email))
        && get(allowedUserPath(request.auth.token.email)).data.email == request.auth.token.email;
    }

    // An allowlist entry bounds what its holder may ever prove. An
    // `admin` entry may prove either scope — that is what lets the owner
    // carry plain shop trust on one machine and later unlock the console
    // from that same machine. A `shop` entry may only ever prove `shop`,
    // so a shop user cannot ask for `admin` and be believed: the role in
    // the allowlist decides, never the one in the request.
    function roleAllows(role, scope) {
      return role == 'admin' ? scope in ['shop', 'admin'] : scope == 'shop';
    }

    function enrollPath(uid) {
      return /databases/$(database)/documents/enrollments/$(uid);
    }

    function grantPath(uid) {
      return /databases/$(database)/documents/accessGrants/$(uid);
    }

    // A browser is trusted iff it holds a grant that is still active.
    // Every money rule calls this, so revoking a grant takes effect on
    // the very next request without touching the session.
    //
    // The `exists()` half is load-bearing, not decoration: `get()` on a
    // document that is not there returns null, and touching a field of
    // null raises an evaluation error rather than yielding false. The
    // error still denies, so this is not a way in either way — but a
    // browser with no grant is an ordinary state, and it should be
    // refused for the ordinary reason.
    function isTrusted(uid) {
      return exists(grantPath(uid)) && get(grantPath(uid)).data.active == true;
    }

    function isAdmin(uid) {
      return isTrusted(uid) && get(grantPath(uid)).data.role == 'admin';
    }

    // The single gate in front of the ledger. Note this is NOT
    // `request.auth != null`: signing in with Google is free and open to
    // anyone, so a session proves nothing on its own.
    function trusted() {
      return signedIn() && isTrusted(request.auth.uid);
    }

    function admin() {
      return signedIn() && isAdmin(request.auth.uid);
    }

    // A grant record. The shape is closed on purpose: nothing rides along
    // that a later rule change might start trusting.
    function validGrantDoc(doc) {
      return doc.keys().hasOnly([
            'active', 'role', 'label', 'client', 'lastUsedAt',
            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ])
        && doc.active is bool
        && doc.role in ['shop', 'admin']
        && doc.label is string && doc.label.size() >= 1 && doc.label.size() <= 80
        && doc.client.keys().hasOnly(['ua', 'lang'])
        && doc.client.ua is string && doc.client.ua.size() <= 100
        && doc.client.lang is string && doc.client.lang.size() <= 40
        && doc.lastUsedAt is timestamp
        && doc.createdAt is timestamp
        && doc.createdBy is string && doc.createdBy.size() >= 1 && doc.createdBy.size() <= 128
        && doc.updatedAt == request.time
        && doc.updatedBy == request.auth.uid;
    }

    // An admin editing a grant may flip trust and change the label, but
    // never rewrite who created it or when.
    function validGrantUpdate(before, after) {
      return validGrantDoc(after)
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.label.size() >= 1 && after.label.size() <= 80
        && (after.role in ['shop', 'admin'])
        && (after.active is bool);
    }

    // The proof-of-authorisation itself. The caller may only ever write
    // a doc at their OWN uid, only once, and only carrying the email
    // Firebase verified for that same account — which must exist in the
    // allowlist, at a role that permits the scope being claimed. An
    // unauthorised account, an account claiming somebody else's address,
    // and a shop user claiming the admin scope all fail to match, so the
    // write is denied and nothing is created.
    function validEnrollment(doc) {
      return doc.keys().hasOnly(['scope', 'email', 'createdAt', 'createdBy'])
        && doc.scope in ['shop', 'admin']
        && doc.email is string
        && doc.email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$')
        && doc.createdAt == request.time
        && doc.createdBy == request.auth.uid
        && isAllowedEmail(doc.email)
        && roleAllows(get(allowedUserPath(request.auth.token.email)).data.role, doc.scope);
    }

    // ---------------- The allowlist ----------------
    // Closed to clients in both directions. Written once by
    // tools/bootstrap-access.mjs with the Admin SDK (which bypasses these
    // rules) and managed the same way. If this document is missing the
    // user cannot be enrolled — that is the intended fail-closed state,
    // not a bug to work around.
    match /allowedUsers/{email} {
      allow read, write: if false;
    }

    // ---------------- Proof of authorisation ----------------
    // Keyed by the caller's own uid, so two browsers cannot share (or
    // race for) one another's proof. The rule below is the server-side
    // allowlist check: the client sends their email, which is accepted
    // only if it exists in allowedUsers.
    //
    // A browser with no ACTIVE grant may always (re)prove itself, so a
    // revoked machine recovers by signing in again instead of
    // having to clear its site data. A browser that is already trusted
    // cannot touch its own proof, so a stolen session cannot use this
    // path to escalate.
    function canProveEmail(uid) {
      return signedIn()
        && request.auth.uid == uid
        && !isTrusted(uid)
        && validEnrollment(request.resource.data);
    }

    // The one way an ALREADY-trusted browser may touch its proof: replace
    // a shop proof with an ADMIN one, so this same device can unlock the
    // console (self-promotion below). It is strictly additive — an
    // untrusted browser proves through canProveEmail as before, a trusted
    // one can only ever move shop -> admin, and neither can write a shop
    // proof this way, so nothing here can grant access the admin role
    // would not have granted anyway.
    function canAddAdminProof(uid) {
      return signedIn()
        && request.auth.uid == uid
        && isTrusted(uid)
        && exists(grantPath(uid))
        && get(grantPath(uid)).data.role == 'shop'
        && get(grantPath(uid)).data.active == true
        && exists(enrollPath(uid))
        && get(enrollPath(uid)).data.scope == 'shop'
        && request.resource.data.scope == 'admin'
        && validEnrollment(request.resource.data);
    }

    match /enrollments/{uid} {
      allow read: if false;
      allow create: if canProveEmail(uid);
      allow update: if canProveEmail(uid) || canAddAdminProof(uid);
      allow delete: if false;
    }

    // Everything except the last-seen stamp is a browser's own: created
    // when and by whom, what it is called, and which UA it reported.
    // Used by both self-service rules below, so neither can quietly
    // rewrite its own history.
    function sameGrantIdentity(before, after) {
      return after.keys().hasOnly([
            'active', 'role', 'label', 'client', 'lastUsedAt',
            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ])
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.label == before.label
        && after.client == before.client
        && after.lastUsedAt is timestamp;
    }

    // ---------------- Trusted browsers ----------------
    // The registry the Developer console manages, and the only authority
    // the money rules above/below consult. Keyed by uid because that is
    // what `request.auth.uid` gives the rules; a cleared browser profile
    // loses the uid and therefore needs to sign in again.
    match /accessGrants/{uid} {
      // A browser can always read its OWN grant — that is how it learns
      // it has been revoked. Listing everyone is an admin capability.
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin(request.auth.uid));

      // Self-enrolment: proven email in, trust out. The role must equal
      // the scope that was proven, so a grant can never be richer than
      // the allowlist entry behind it — the admin role is the only thing
      // that can ever mint an admin grant.
      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(grantPath(uid))
        && exists(enrollPath(uid))
        && get(enrollPath(uid)).data.scope == request.resource.data.role
        && request.resource.data.role in ['shop', 'admin']
        && request.resource.data.active == true
        && validGrantDoc(request.resource.data);

      allow update: if (
        // An admin may revoke, restore, re-label or delete-by-demotion
        // any browser.
        admin() && validGrantUpdate(resource.data, request.resource.data)
        ) || (
        // Self-promotion: the only capability a browser may add to its
        // own grant is shop -> admin, and only by presenting a valid
        // ADMIN-scope proof while already holding active shop trust.
        signedIn()
        && request.auth.uid == uid
        && resource.data.role == 'shop'
        && resource.data.active == true
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
        && validGrantDoc(request.resource.data)
        && sameGrantIdentity(resource.data, request.resource.data)
        && exists(enrollPath(uid))
        && get(enrollPath(uid)).data.scope == 'admin'
      ) || (
        // Reactivation: a browser that was revoked can come back on its
        // own by proving the SHOP scope again. The role and identity are
        // pinned, so this restores shop access and nothing more — it can
        // never turn a demoted admin into an admin again (that would
        // need an ADMIN-scope proof via the branch above).
        signedIn()
        && request.auth.uid == uid
        && resource.data.active == false
        && request.resource.data.active == true
        && request.resource.data.role == 'shop'
        && sameGrantIdentity(resource.data, request.resource.data)
        && request.resource.data.lastUsedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && exists(enrollPath(uid))
        && get(enrollPath(uid)).data.scope == 'shop'
      ) || (
        // Heartbeat: a browser may only move its own last-seen stamp, so
        // the console can show which machines are actually in use.
        // Trust and role are untouched, so this can never be used to
        // keep a revoked browser alive.
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && sameGrantIdentity(resource.data, request.resource.data)
        && request.resource.data.lastUsedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
      );

      allow delete: if admin();
    }

    function headPath(dk) {
      return /databases/$(database)/documents/dayHeads/$(dk);
    }

    function servicePath(svcId) {
      return /databases/$(database)/documents/services/$(svcId);
    }

    // Field ranges, mirroring the client guards in js/utils.js so a bad
    // write is caught before the network rather than after it.
    function validQuantity(q) {
      return q is int && q >= 1 && q <= 100000;
    }
    function validRate(r) {
      return r is number && r >= 0 && r <= 10000000;
    }
    function validTotal(t) {
      return t is number && t >= 0 && t <= 100000000000;
    }

    // A counter set is valid when nothing is negative, the four payment
    // buckets add up to the gross, and what has been collected is the
    // gross minus what is still outstanding. The cap is a whole day of
    // maximum-value sales, so a real counter can never hit it.
    function countersOk(c) {
      return c.keys().hasOnly([
            'txnCount', 'grossPaise', 'cashPaise', 'upiPaise',
            'cardPaise', 'duePaise', 'collectedPaise'
          ])
        && c.txnCount is int && c.txnCount >= 0 && c.txnCount <= 1000000
        && c.grossPaise is int && c.grossPaise >= 0 && c.grossPaise <= 100000000000000
        && c.cashPaise is int && c.cashPaise >= 0
        && c.upiPaise is int && c.upiPaise >= 0
        && c.cardPaise is int && c.cardPaise >= 0
        && c.duePaise is int && c.duePaise >= 0
        && c.collectedPaise is int && c.collectedPaise >= 0
        && c.grossPaise == c.cashPaise + c.upiPaise + c.cardPaise + c.duePaise
        && c.collectedPaise == c.grossPaise - c.duePaise;
    }

    // The per-method split of a sale's total. Written without a ternary
    // and without building a map, because the rules language has
    // neither: each bucket is proved to be either 0 or the whole total,
    // the buckets are proved to add up to the total, and the one
    // non-zero bucket is proved to be this sale's payment method. That
    // is exactly as binding as a branch would be.
    function validAmounts(t) {
      return t.amounts.keys().hasOnly([
            'gross', 'cash', 'upi', 'card', 'due', 'collected'
          ])
        && t.amounts.gross is int && t.amounts.gross == t.total
        && t.amounts.cash is int
        && t.amounts.upi is int
        && t.amounts.card is int
        && t.amounts.due is int
        && t.amounts.collected is int
        && t.amounts.cash + t.amounts.upi + t.amounts.card + t.amounts.due == t.total
        && (t.amounts.cash > 0) == (t.paymentMethod == 'cash')
        && (t.amounts.upi > 0) == (t.paymentMethod == 'upi')
        && (t.amounts.card > 0) == (t.paymentMethod == 'card')
        && (t.amounts.due > 0) == (t.paymentMethod == 'due')
        && t.amounts.collected == t.total - t.amounts.due;
    }

    // The head moved by exactly one sale's contribution (`a`), in the
    // sale's direction (`step` is +1 for a create, -1 for a delete).
    function headSteppedBy(before, after, a, step) {
      return countersOk(after)
        && after.txnCount == before.txnCount + step
        && after.grossPaise == before.grossPaise + a.gross * step
        && after.cashPaise == before.cashPaise + a.cash * step
        && after.upiPaise == before.upiPaise + a.upi * step
        && after.cardPaise == before.cardPaise + a.card * step
        && after.duePaise == before.duePaise + a.due * step
        && after.collectedPaise == before.collectedPaise + a.collected * step;
    }

    // The head moved by exactly the difference between an old sale and
    // its edited form: the sale count is untouched, only the split moves.
    function headShiftedBy(before, after, a, b) {
      return countersOk(after)
        && after.txnCount == before.txnCount
        && after.grossPaise == before.grossPaise - b.gross + a.gross
        && after.cashPaise == before.cashPaise - b.cash + a.cash
        && after.upiPaise == before.upiPaise - b.upi + a.upi
        && after.cardPaise == before.cardPaise - b.card + a.card
        && after.duePaise == before.duePaise - b.due + a.due
        && after.collectedPaise == before.collectedPaise - b.collected + a.collected;
    }

    // A day is open unless its head says otherwise. Read from the head
    // rather than from a separate days collection, so the state and the
    // rows it governs are one document apart.
    function dayOpen(dk) {
      return exists(headPath(dk)) && get(headPath(dk)).data.state == 'open';
    }

    // ---------------- The day head ----------------
    // One document per Asia/Kolkata business day. Created once, on that
    // day's first sale (js/ledger.js ensureDayHead), with zeroed
    // counters, so the client never has to guess whether it exists.
    match /dayHeads/{dateKey} {
      function validHeadCreate(doc) {
        return doc.keys().hasOnly([
              'dateKey', 'state', 'openedAt', 'openedBy',
              'counters', 'updatedAt', 'updatedBy'
            ])
          && doc.dateKey is string
          && doc.dateKey == dateKey
          && doc.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && doc.state == 'open'
          && doc.openedAt == request.time
          && doc.openedBy == request.auth.uid
          && doc.updatedAt == request.time
          && doc.updatedBy == request.auth.uid
          && countersOk(doc.counters)
          && doc.counters.txnCount == 0
          && doc.counters.grossPaise == 0;
      }

      // An OPEN head carries no closing stamp at all, so a stale
      // closedAt/closedBy can never ride along on a counter write.
      function openHeadShape(doc) {
        return doc.keys().hasOnly([
              'dateKey', 'state', 'openedAt', 'openedBy',
              'counters', 'updatedAt', 'updatedBy'
            ])
          && !doc.keys().hasAny(['closedAt', 'closedBy'])
          && doc.state == 'open'
          && commonHeadShape(doc);
      }

      // A CLOSED head must carry a fresh, real closing stamp.
      function closedHeadShape(doc) {
        return doc.keys().hasOnly([
              'dateKey', 'state', 'openedAt', 'openedBy',
              'counters', 'closedAt', 'closedBy',
              'updatedAt', 'updatedBy'
            ])
          && doc.state == 'closed'
          && doc.closedAt == request.time
          && doc.closedBy == request.auth.uid
          && commonHeadShape(doc);
      }

      function commonHeadShape(doc) {
        return doc.dateKey is string
          && doc.dateKey == dateKey
          && doc.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && doc.openedAt is timestamp
          && doc.openedBy is string
          && countersOk(doc.counters)
          && doc.updatedAt == request.time
          && doc.updatedBy == request.auth.uid;
      }

      // The head cannot see the sale that moved its counters, so its own
      // write rule only bounds the change: a no-op merge, a shift of at
      // most one sale in or out, and the one-way close. The sale's rules
      // below are what prove the delta was exact.
      function boundedCounterStep(before, after) {
        return countersOk(after)
          && (after.txnCount == before.txnCount
              || after.txnCount == before.txnCount + 1
              || after.txnCount == before.txnCount - 1)
          && after.grossPaise <= before.grossPaise + 100000000000
          && after.grossPaise + 100000000000 >= before.grossPaise
          && after.cashPaise <= before.cashPaise + 100000000000
          && after.cashPaise + 100000000000 >= before.cashPaise
          && after.upiPaise <= before.upiPaise + 100000000000
          && after.upiPaise + 100000000000 >= before.upiPaise
          && after.cardPaise <= before.cardPaise + 100000000000
          && after.cardPaise + 100000000000 >= before.cardPaise
          && after.duePaise <= before.duePaise + 100000000000
          && after.duePaise + 100000000000 >= before.duePaise
          && after.collectedPaise <= before.collectedPaise + 100000000000
          && after.collectedPaise + 100000000000 >= before.collectedPaise;
      }

      allow read: if trusted();

      allow create: if trusted() && validHeadCreate(request.resource.data);

      allow update: if trusted()
        && (
            // Re-asserting a head the client just found, changing
            // nothing. Keeps the "make sure the day exists" step from
            // needing to know whether it won the create race.
            (
              resource.data.state == 'open'
              && request.resource.data.counters == resource.data.counters
              && openHeadShape(request.resource.data)
            )
            // Counters moved, but only by a single sale's worth. The
            // sale's own rule below proves the delta was exact.
            || (
              resource.data.state == 'open'
              && request.resource.data.state == 'open'
              && boundedCounterStep(resource.data.counters, request.resource.data.counters)
              && openHeadShape(request.resource.data)
            )
            // Close the day: one way only, counters untouched.
            || (
              resource.data.state == 'open'
              && request.resource.data.counters == resource.data.counters
              && closedHeadShape(request.resource.data)
            )
          );

      // A closed day is permanent, and so is a head that is on disk:
      // nothing may re-open a day, re-date a head, or delete the register.
      allow delete: if false;
    }

    // Sales, inside their day. The service catalog now lives in the same
    // Firestore database, so rules CAN verify via get() that the service
    // exists and is active at write time — stronger than the old snapshot-
    // only check that was needed when the catalog was on the RTDB.
    match /dayHeads/{dateKey}/transactions/{txnId} {
      function validTransactionDoc(doc) {
        return doc.keys().hasOnly([
              'txnId', 'serviceId', 'serviceName', 'quantity',
              'rate', 'total', 'amounts', 'paymentMethod',
              'customerId', 'customerName', 'status', 'dateKey',
              'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
            ])
          && doc.txnId is string && doc.txnId.size() <= 120
          && doc.txnId == txnId
          && doc.serviceId is string
          && doc.serviceId.size() >= 1 && doc.serviceId.size() <= 120
          && exists(servicePath(doc.serviceId))
          && get(servicePath(doc.serviceId)).data.active == true
          && doc.serviceName is string
          && doc.serviceName.size() >= 1 && doc.serviceName.size() <= 80
          && doc.serviceName == get(servicePath(doc.serviceId)).data.name
          && validQuantity(doc.quantity)
          && validRate(doc.rate)
          && validTotal(doc.total)
          && doc.total == doc.quantity * doc.rate
          && doc.paymentMethod in ['cash', 'upi', 'card', 'due']
          && validAmounts(doc)
          && doc.customerId is string && doc.customerId.size() <= 200
          && doc.customerName is string && doc.customerName.size() <= 120
          && doc.status in ['paid', 'pending']
          && ((doc.paymentMethod == 'due' && doc.status in ['pending', 'paid'])
              || (doc.paymentMethod != 'due' && doc.status == 'paid'))
          && doc.dateKey is string
          && doc.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && doc.dateKey == dateKey
          && doc.createdBy == request.auth.uid
          && doc.updatedBy == request.auth.uid
          && doc.createdAt == request.time
          && doc.updatedAt == request.time;
      }

      function validTransactionEdit(before, after) {
        return after.keys().hasOnly([
              'txnId', 'serviceId', 'serviceName', 'quantity',
              'rate', 'total', 'amounts', 'paymentMethod',
              'customerId', 'customerName', 'status', 'dateKey',
              'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
            ])
          && after.txnId == before.txnId
          && after.serviceId == before.serviceId
          && after.dateKey == before.dateKey
          && after.dateKey == dateKey
          && after.createdAt == before.createdAt
          && after.createdBy == before.createdBy
          && after.customerId == before.customerId
          && after.serviceId is string && after.serviceId.size() >= 1
          && exists(servicePath(after.serviceId))
          && get(servicePath(after.serviceId)).data.active == true
          && after.serviceName is string
          && after.serviceName.size() >= 1 && after.serviceName.size() <= 80
          && after.serviceName == get(servicePath(after.serviceId)).data.name
          && validQuantity(after.quantity)
          && validRate(after.rate)
          && validTotal(after.total)
          && after.total == after.quantity * after.rate
          && after.paymentMethod in ['cash', 'upi', 'card', 'due']
          && validAmounts(after)
          && after.customerName is string && after.customerName.size() <= 120
          && after.status in ['paid', 'pending']
          && ((after.paymentMethod == 'due' && after.status in ['pending', 'paid'])
              || (after.paymentMethod != 'due' && after.status == 'paid'))
          && after.updatedBy == request.auth.uid
          && after.updatedAt == request.time;
      }

      // `read` also authorizes a collection-group query across every
      // day's sales, which is what the Developer console's "All recent"
      // view uses. The day is still enforced per document, because the
      // head state is read from the document's own parent path.
      allow read: if trusted();

      // Creating a sale and advancing the day's counters is ONE batch, so
      // the head must move by exactly this sale's contribution.
      allow create: if trusted()
        && dayOpen(dateKey)
        && validTransactionDoc(request.resource.data)
        && exists(headPath(dateKey))
        && headSteppedBy(
             get(headPath(dateKey)).data.counters,
             getAfter(headPath(dateKey)).data.counters,
             request.resource.data.amounts,
             1
           );

      // Editing a sale may move money between payment buckets, so the
      // head shifts by the difference between the old and new split.
      allow update: if trusted()
        && dayOpen(dateKey)
        && validTransactionEdit(resource.data, request.resource.data)
        && exists(headPath(dateKey))
        && headShiftedBy(
             get(headPath(dateKey)).data.counters,
             getAfter(headPath(dateKey)).data.counters,
             request.resource.data.amounts,
             resource.data.amounts
           );

      // Deleting retreats the counters by exactly this sale.
      allow delete: if trusted()
        && dayOpen(dateKey)
        && exists(headPath(dateKey))
        && headSteppedBy(
             get(headPath(dateKey)).data.counters,
             getAfter(headPath(dateKey)).data.counters,
             resource.data.amounts,
             -1
           );
    }

    // ---------------- Services ----------------
    // Any signed-in (allowlist-gated) device may create, rename, re-price or
    // archive services. Deletion is never allowed, so "removal" means
    // setting active=false.
    match /services/{serviceId} {
      function validServiceDoc(doc) {
        return doc.keys().hasOnly([
              'serviceId', 'name', 'code', 'pricePaise',
              'active', 'sortOrder', 'createdAt', 'createdBy',
              'updatedAt', 'updatedBy'
            ])
          && doc.serviceId is string && doc.serviceId.size() <= 120
          && doc.serviceId == serviceId
          && doc.name is string && doc.name.size() >= 1 && doc.name.size() <= 80
          && doc.code is string && doc.code.size() <= 12
          && doc.pricePaise is number && doc.pricePaise >= 0 && doc.pricePaise <= 10000000
          && doc.active is bool
          && doc.sortOrder is number
          && doc.createdBy == request.auth.uid
          && doc.updatedBy == request.auth.uid
          && doc.createdAt == request.time
          && doc.updatedAt == request.time;
      }

      function validServiceUpdate(doc) {
        return doc.keys().hasOnly([
              'serviceId', 'name', 'code', 'pricePaise',
              'active', 'sortOrder', 'createdAt', 'createdBy',
              'updatedAt', 'updatedBy'
            ])
          && doc.serviceId is string && doc.serviceId.size() <= 120
          && doc.serviceId == serviceId
          && doc.name is string && doc.name.size() >= 1 && doc.name.size() <= 80
          && doc.code is string && doc.code.size() <= 12
          && doc.pricePaise is number && doc.pricePaise >= 0 && doc.pricePaise <= 10000000
          && doc.active is bool
          && doc.sortOrder is number
          && doc.createdAt == resource.data.createdAt
          && doc.createdBy == resource.data.createdBy
          && doc.updatedAt == request.time
          && doc.updatedBy == request.auth.uid;
      }

      allow read: if trusted();

      allow create: if trusted()
        && validServiceDoc(request.resource.data);

      allow update: if trusted()
        && validServiceUpdate(request.resource.data);

      allow delete: if false;
    }

    // ---------------- The shop record ----------------
    // Shop identity (name, phone, address). This used to be a Realtime
    // Database path, but RTDB rules cannot read a Firestore grant, so
    // "auth != null" there meant *any* Google Firebase user could
    // rewrite the shop's details. Here it sits behind the same trusted()
    // gate as the money, with one document and no delete.
    match /shop/{docId} {
      function validShopDoc(doc) {
        return doc.keys().hasOnly([
              'name', 'phone', 'address', 'currency', 'active',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
            ])
          && doc.name is string && doc.name.size() >= 1 && doc.name.size() <= 80
          && doc.phone is string && doc.phone.size() <= 20
          && doc.address is string && doc.address.size() <= 300
          && doc.currency == 'INR'
          && doc.active == true
          && doc.createdAt is timestamp
          && doc.createdBy == request.auth.uid
          && doc.updatedAt == request.time
          && doc.updatedBy == request.auth.uid;
      }

      allow read: if trusted();

      allow create: if trusted()
        && docId == 'general'
        && validShopDoc(request.resource.data);

      allow update: if trusted()
        && docId == 'general'
        && validShopDoc(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;
    }

    // Everything else is denied. Expenses are the one remaining Realtime
    // Database path, and anything not listed above is not part of this
    // app — in particular there is no way back to the old `admins/**` or
    // `devices/**` collections from here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
