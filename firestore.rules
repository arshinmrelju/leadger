rules_version = '2';

// =============================================================
// SEVA LEDGER — Cloud Firestore security rules
// -------------------------------------------------------------
// SINGLE-SHOP (flat) model. There is no per-shop namespace; this
// instance IS one shop.
//
// Simple trust model: the shop opens with one shared code, verified
// SERVER-SIDE at enrollment. A browser that proves the code once mints
// a 256-bit random token (kept only in its IndexedDB); the token's
// sha256 is a devices/<hash> document that auto-authenticates it on
// later visits. Firestore's job here is record integrity and the
// trust registry:
//   * The auto-login gate can GET a device doc anonymously because its
//     id is an unguessable 256-bit capability; a real session is only
//     created for trusted/verified devices, so data stays code-gated.
//   * Only signed-in (anonymous) devices touch data.
//   * Every document is strongly typed and non-forgeable on the
//     server: createdBy == request.auth.uid, createdAt == request.time,
//     transactions money stays integer paise with
//     total == quantity * rate, services must exist and be active,
//     fields are range-checked.
//   * Nothing is ever deleted (services archive with active=false),
//     with one deliberate exception: a sale on a still-open business
//     day can be deleted from the daily ledger. Once a day is closed
//     its rows are frozen — see match /days and dayOpen() above.
//
// Data model covered here:
//   settings/general               shop identity (auto-created on first use)
//   settings/security              the access code (server-side only; never client-readable)
//   enrollments/{nonce}            one-time proof-of-code (single use)
//   devices/{tokenHash}            trusted-device registry (auto-login + revocation)
//   transactions/{txnId}           sales (editable + deletable while the day is open)
//   services/{serviceId}           service catalog
//   expenses/{expId}               spends (read-only this build)
//   days/{dateKey}                 closed business days (absent = open)
//
// The old members/ and pendingMembers/ collections are no longer
// used; the deny-all tail below keeps them unreachable.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function unsigned() {
      return request.auth == null;
    }

    // A business day is open unless a days/{dateKey} document says
    // otherwise. This is what the daily ledger consults before letting
    // anyone edit, settle or delete a sale.
    function dayOpen(dateKey) {
      return !exists(/databases/$(database)/documents/days/$(dateKey));
    }

    function validGeneralDoc(doc) {
      return doc.keys().hasOnly([
            'name', 'phone', 'address',
            'currency', 'active', 'createdAt', 'createdBy'
          ])
        && doc.name is string
        && doc.name.size() >= 1
        && doc.name.size() <= 80
        && doc.phone is string
        && doc.phone.size() <= 20
        && doc.address is string
        && doc.address.size() <= 300
        && doc.currency is string
        && doc.currency.size() == 3
        && doc.active == true;
    }

    // ---------------- Settings ----------------
    // `general` is the shop record: silently auto-created the first
    // time any code-signed-in device opens the app (see auth.js
    // ensureShopRecord). Update is open to any signed-in device — one
    // shop, one identity.
    // `security` carries the access code used for device enrollment.
    // It is NEVER readable or writable by clients after creation:
    // only the rules engine compares it to an enrollment attempt, so
    // the code itself never leaves Firestore's server boundary.
    match /settings/{docId} {
      allow get, list: if signedIn() && docId != 'security';

      allow create: if signedIn()
        && (
            (docId == 'general'
             && !exists(/databases/$(database)/documents/settings/general)
             && validGeneralDoc(request.resource.data)
             && request.resource.data.createdAt == request.time
             && request.resource.data.createdBy == request.auth.uid)
            || (docId == 'security'
                && !exists(/databases/$(database)/documents/settings/security)
                && request.resource.data.keys().hasOnly(['accessCode', 'createdAt', 'createdBy'])
                && request.resource.data.accessCode.matches('^[A-Z0-9]{4,12}$')
                && request.resource.data.createdAt == request.time
                && request.resource.data.createdBy == request.auth.uid)
          );

      allow update: if signedIn()
        && docId == 'general'
        && validGeneralDoc(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;
    }

    // ---------------- Device enrollment (proof-of-code, single use) ----------------
    // First-time devices prove possession of the access code by writing
    // a one-time enrollment nonce. The rules compare the submitted
    // `verifiedCode` against settings/security.accessCode server-side.
    // The client then creates the actual `devices` document keyed to
    // this enrollment, marks it `used`, and deletes it. The code is
    // never persisted anywhere a client can read.
    match /enrollments/{nonce} {
      allow create: if signedIn()
        && nonce.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['verifiedCode', 'createdAt', 'createdBy', 'used'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.used == false
        && exists(/databases/$(database)/documents/settings/security)
        && get(/databases/$(database)/documents/settings/security).data.accessCode
             == request.resource.data.verifiedCode;

      allow get, list: if false;

      // Only the owner flips `used` after the device doc exists.
      allow update: if signedIn()
        && request.auth.uid == resource.data.createdBy
        && request.resource.data.keys().hasOnly(['used', 'deviceHash'])
        && request.resource.data.used == true
        && request.resource.data.deviceHash is string
        && request.resource.data.deviceHash.matches('^[a-f0-9]{64}$');

      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;
    }

    // ---------------- Trusted devices ----------------
    // A recognized browser holds a 256-bit random token whose SHA-256
    // is this document id. The id is UNGUESSABLE (2^256), so it acts as
    // a capability: an unauthenticated visitor may GET a device doc by
    // id to run the auto-login gate BEFORE creating any session, while
    // listing is reserved for signed-in devices. An ACTIVE
    // devices/<tokenHash> doc enables automatic sign-in without the
    // access code; revocation (active = false) or removal forces
    // verification again. The network/client fields are coarse
    // metadata only (no IP, no fingerprinting).
    match /devices/{tokenHash} {
      function validDeviceCreateDoc(doc) {
        return doc.keys().hasOnly([
              'tokenHash', 'uid', 'label', 'client', 'network',
              'createdAt', 'createdBy', 'lastUsedAt', 'lastUsedNetwork',
              'active', 'enrollmentId'
            ])
          && doc.tokenHash is string && doc.tokenHash.matches('^[a-f0-9]{64}$') && doc.tokenHash == tokenHash
          && doc.uid is string && doc.uid == request.auth.uid && doc.uid == doc.createdBy
          && doc.label is string && doc.label.size() >= 1 && doc.label.size() <= 80
          && doc.client is map
          && doc.client.keys().hasOnly(['ua', 'lang'])
          && doc.client.ua is string && doc.client.ua.size() <= 100
          && doc.client.lang is string && doc.client.lang.size() <= 40
          && doc.network is map
          && doc.network.keys().hasOnly(['type', 'saveData', 'online'])
          && doc.network.type is string && doc.network.type.size() <= 20
          && doc.network.saveData is bool
          && doc.network.online is bool
          && doc.active == true
          && doc.enrollmentId is string && doc.enrollmentId.matches('^[a-f0-9]{32}$')
          && exists(/databases/$(database)/documents/enrollments/$(doc.enrollmentId))
          && get(/databases/$(database)/documents/enrollments/$(doc.enrollmentId)).data.createdBy == request.auth.uid
          && doc.createdBy == request.auth.uid
          && doc.createdAt == request.time
          && doc.lastUsedAt == request.time;
      }

      allow read: if signedIn();
      // Capability read: the 64-hex doc id is the sha256 of a 256-bit
      // random token held only by the trusted browser, so knowing the
      // id == owning the credential before any session exists.
      allow get: if unsigned();

      allow create: if signedIn()
        && validDeviceCreateDoc(request.resource.data)
        && get(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId)).data.used == false;

      allow update: if signedIn()
        && (
            // Any signed-in device may revoke (active true -> false).
            (request.resource.data.active == false
             && resource.data.active == true
             && request.resource.data.keys().hasOnly(['active']))
            ||
            // The owning device maintains heartbeat / rename / restore.
            (request.auth.uid == resource.data.createdBy
             && request.resource.data.keys().hasOnly(['lastUsedAt', 'lastUsedNetwork', 'label', 'active'])
             && request.resource.data.lastUsedAt == request.time
             && request.resource.data.lastUsedNetwork is map
             && request.resource.data.lastUsedNetwork.keys().hasOnly(['type', 'saveData', 'online'])
             && request.resource.data.lastUsedNetwork.type is string
             && request.resource.data.lastUsedNetwork.type.size() <= 20
             && request.resource.data.lastUsedNetwork.saveData is bool
             && request.resource.data.lastUsedNetwork.online is bool
             && request.resource.data.label is string && request.resource.data.label.size() >= 1 && request.resource.data.label.size() <= 80
             && request.resource.data.active is bool)
          );

      // Full removal (cleanup). The audit-friendly path is revoke
      // (active = false) which any signed-in device can do above.
      allow delete: if signedIn();
    }

    // ---------------- Transactions ----------------
    // Single-method sales. Money is integer paise; `rate` is paise per
    // unit, `total` = quantity x rate, `dateKey` is the Asia/Kolkata
    // business-day key, `createdAt` orders the day.
    //
    // Editing (daily ledger) is deliberately narrow: the descriptive
    // fields may move, but txnId / serviceId / createdAt / createdBy /
    // dateKey are pinned. Pinning dateKey is what makes the day-close
    // gate sound — a sale can never be re-dated onto a closed day, nor
    // pulled off one. `total` is re-derived from quantity x rate on
    // every write, so money is never client-asserted.
    match /transactions/{txnId} {
      function validTransactionDoc(doc) {
        return doc.keys().hasOnly([
              'txnId', 'serviceId', 'serviceName', 'quantity',
              'rate', 'total', 'paymentMethod', 'customerId',
              'customerName', 'status', 'dateKey',
              'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
            ])
          && doc.txnId is string && doc.txnId.size() <= 120
          && doc.txnId == txnId
          && doc.serviceId is string && doc.serviceId.size() >= 1 && doc.serviceId.size() <= 120
          && exists(/databases/$(database)/documents/services/$(doc.serviceId))
          && get(/databases/$(database)/documents/services/$(doc.serviceId)).data.active == true
          && doc.serviceName is string && doc.serviceName.size() >= 1 && doc.serviceName.size() <= 80
          && doc.serviceName == get(/databases/$(database)/documents/services/$(doc.serviceId)).data.name
          && doc.quantity is int && doc.quantity >= 1 && doc.quantity <= 100000
          && doc.rate is number && doc.rate >= 0 && doc.rate <= 10000000
          && doc.total is number && doc.total >= 0 && doc.total <= 100000000000
          && doc.total == doc.quantity * doc.rate
          && doc.paymentMethod in ['cash', 'upi', 'card', 'due']
          && doc.customerId is string && doc.customerId.size() <= 200
          && doc.customerName is string && doc.customerName.size() <= 120
          && doc.status in ['paid', 'pending']
          && ((doc.paymentMethod == 'due' && doc.status in ['pending', 'paid'])
              || (doc.paymentMethod != 'due' && doc.status == 'paid'))
          && doc.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && doc.createdBy == request.auth.uid
          && doc.updatedBy == request.auth.uid
          && doc.createdAt == request.time
          && doc.updatedAt == request.time;
      }

      // The editable surface of a sale. Everything here is re-validated
      // against the live service doc so an edit cannot leave a row whose
      // serviceName disagrees with the catalog.
      function validTransactionEdit(before, after) {
        return after.keys().hasAll([
              'txnId', 'serviceId', 'serviceName', 'quantity',
              'rate', 'total', 'paymentMethod', 'customerId',
              'customerName', 'status', 'dateKey',
              'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
            ])
          && after.txnId == before.txnId
          && after.serviceId == before.serviceId
          && after.dateKey == before.dateKey
          && after.createdAt == before.createdAt
          && after.createdBy == before.createdBy
          && after.customerId == before.customerId
          && after.serviceId is string && after.serviceId.size() >= 1
          && exists(/databases/$(database)/documents/services/$(after.serviceId))
          && get(/databases/$(database)/documents/services/$(after.serviceId)).data.active == true
          && after.serviceName is string && after.serviceName.size() >= 1 && after.serviceName.size() <= 80
          && after.serviceName == get(/databases/$(database)/documents/services/$(after.serviceId)).data.name
          && after.quantity is int && after.quantity >= 1 && after.quantity <= 100000
          && after.rate is number && after.rate >= 0 && after.rate <= 10000000
          && after.total is number && after.total >= 0 && after.total <= 100000000000
          && after.total == after.quantity * after.rate
          && after.paymentMethod in ['cash', 'upi', 'card', 'due']
          && after.customerName is string && after.customerName.size() <= 120
          && after.status in ['paid', 'pending']
          && ((after.paymentMethod == 'due' && after.status in ['pending', 'paid'])
              || (after.paymentMethod != 'due' && after.status == 'paid'))
          && after.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && after.updatedBy == request.auth.uid
          && after.updatedAt == request.time;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && validTransactionDoc(request.resource.data);

      // Editing or settling a sale is only possible while the business
      // day is still open, and only by a signed-in device.
      allow update: if signedIn()
        && dayOpen(resource.data.dateKey)
        && validTransactionEdit(resource.data, request.resource.data);

      // Deleting is likewise confined to an open day. There is no
      // per-user ownership check because every signed-in device is the
      // same shop — see the trust model above.
      allow delete: if signedIn()
        && dayOpen(resource.data.dateKey);
    }

    // ---------------- Services ----------------
    // Any signed-in (code-gated) device may create, rename, re-price or
    // archive services. Deletion is never allowed, so "removal" means
    // setting active=false.
    match /services/{serviceId} {
      function validServiceDoc(doc) {
        return doc.keys().hasOnly([
              'serviceId', 'name', 'code', 'pricePaise',
              'active', 'sortOrder', 'createdAt', 'createdBy',
              'updatedAt', 'updatedBy'
            ])
          && doc.serviceId is string && doc.serviceId.size() <= 120
          && doc.serviceId == serviceId
          && doc.name is string && doc.name.size() >= 1 && doc.name.size() <= 80
          && doc.code is string && doc.code.size() <= 12
          && doc.pricePaise is number && doc.pricePaise >= 0 && doc.pricePaise <= 10000000
          && doc.active is bool
          && doc.sortOrder is number
          && doc.createdBy == request.auth.uid
          && doc.updatedBy == request.auth.uid
          && doc.createdAt == request.time
          && doc.updatedAt == request.time;
      }

      function validServiceUpdate(doc) {
        return doc.keys().hasOnly([
              'serviceId', 'name', 'code', 'pricePaise',
              'active', 'sortOrder', 'createdAt', 'createdBy',
              'updatedAt', 'updatedBy'
            ])
          && doc.serviceId is string && doc.serviceId.size() <= 120
          && doc.serviceId == serviceId
          && doc.name is string && doc.name.size() >= 1 && doc.name.size() <= 80
          && doc.code is string && doc.code.size() <= 12
          && doc.pricePaise is number && doc.pricePaise >= 0 && doc.pricePaise <= 10000000
          && doc.active is bool
          && doc.sortOrder is number
          && doc.createdAt == resource.data.createdAt
          && doc.createdBy == resource.data.createdBy
          && doc.updatedAt == request.time
          && doc.updatedBy == request.auth.uid;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && validServiceDoc(request.resource.data);

      allow update: if signedIn()
        && validServiceUpdate(request.resource.data);

      allow delete: if false;
    }

    // ---------------- Expenses (read-only this build) ----------------
    match /expenses/{expId} {
      function validExpenseDoc(doc) {
        return doc.keys().hasOnly([
              'expId', 'date', 'title', 'category',
              'amountPaise', 'note', 'createdBy', 'createdAt',
              'updatedAt', 'updatedBy'
            ])
          && doc.expId is string && doc.expId.size() <= 120
          && doc.expId == expId
          && doc.date is string && doc.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && doc.title is string && doc.title.size() <= 160
          && doc.category is string && doc.category.size() <= 60
          && doc.amountPaise is number && doc.amountPaise >= 0
          && doc.note is string && doc.note.size() <= 500;
      }

      allow read: if signedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ---------------- Business days ----------------
    // days/{dateKey} is the close-day register. A document only exists
    // for a day that has been closed; every other day is open because
    // `exists()` is false. The close-day action itself ships in a later
    // part — what matters here is that the transaction rules above
    // already respect a closed day, so nothing that lands in a closed
    // day can afterwards be edited or deleted.
    match /days/{dateKey} {
      function validDayDoc(doc) {
        return doc.keys().hasOnly(['dateKey', 'closed', 'closedAt', 'closedBy'])
          && doc.dateKey is string
          && doc.dateKey == dateKey
          && doc.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && doc.closed == true
          && doc.closedAt == request.time
          && doc.closedBy == request.auth.uid;
      }

      allow read: if signedIn();
      allow create: if signedIn() && validDayDoc(request.resource.data);
      // A closed day is permanent: nothing may re-open or re-date it.
      allow update: if false;
      allow delete: if false;
    }

    // Everything else (members, pendingMembers, …) is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}