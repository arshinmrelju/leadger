/* =========================================================
   TrustX Ledger — Firebase Storage security rules
   -----------------------------------------------------------
   Files stored here are ONLY shop notebook scans, compressed
   and uploaded by the shopkeeper's own signed-in account.
   Rules:
     • Write: ONLY signed-in + trusted + the path starts with
              receipts/{their own uid}/
     • Read:  ONLY signed-in + trusted + path starts with
              receipts/{their own uid}/
     • Size:  ≤ 500 KB  (compress on client BEFORE upload,
              enforced here again so a misconfigured client
              can't blow through the free tier)
     • Type:  image/jpeg only (not HEIC, not PNG, not video)
   There is NO public access. Nobody else's account can list
   or read your notebook pages, even if they hold a URL.
   ========================================================= */

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny everything explicitly that does not hit the allowed path.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function trusted() {
      return request.auth != null
        && request.auth.uid != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$')
        && exists(/databases/$(database)/documents/accessGrants/$(request.auth.uid));
    }

    match /receipts/{uid}/{allPaths=**} {
      allow read, write: if
          trusted()
          && request.auth.uid == uid
          && request.resource.size <= 500 * 1024
          && request.resource.contentType == 'image/jpeg';
    }
  }
}
