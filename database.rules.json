{
  "rules": {
    ".read": false,
    ".write": false,

    "settings": {
      ".read": false,
      ".write": false,

      "general": {
        ".read": false,
        ".write": false
      },
      "security": {
        ".read": false,
        ".write": false
      },
      "admin": {
        ".read": false,
        ".write": false
      }
    },

    "enrollments": {
      ".read": false,
      ".write": false
    },

    "devices": {
      ".read": false,
      ".write": false
    },

    "admins": {
      ".read": false,
      ".write": false
    },

    "expenses": {
      ".read": "auth != null",
      ".write": false,

      "$dateKey": {
        "$expId": {
          "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "title": { ".validate": "newData.isString() && newData.val().matches(/^[\\u0000-\\uFFFF]{1,120}$/)" },
          "category": { ".validate": "newData.isString() && newData.val().matches(/^[\\u0000-\\uFFFF]{0,40}$/)" },
          "amountPaise": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "createdBy": { ".validate": "newData.isString() && newData.val().matches(/^[\\u0000-\\uFFFF]{1,128}$/)" }
        }
      }
    }
  }
}
